<http://example.org/kg/work/618864199> a schema1:Book ;
    rdfs:label "Verschwunden" ;
    schema1:about <http://example.org/kg/person/germano_gustavo>,
        <http://example.org/kg/subject/argentinien>,
        <http://example.org/kg/subject/biografien>,
        <http://example.org/kg/subject/gewalt>,
        <http://example.org/kg/subject/kunst>,
        <http://example.org/kg/subject/militardiktatur>,
        <http://example.org/kg/subject/sudamerika>,
        <http://example.org/kg/subject/verschleppung> ;
    schema1:abstract "Während der Zeit der Militätdiktatur sind in Argentinien 30 000 Menschen verschwunden, sie wurden gekidnappt, gefoltert, erschossen und verscharrt oder betäubt und vom Flugzeug aus ins Meer geworfen. Jetzt sucht eine Generation von Künstlern, das Grauen ihrer Kindheit auszudrücken. Gustavo Germano (geb. 1964) hat dafür alte Bilder aus Familienalben gesucht und diese Aufnahmen 30 Jahre später nachgestellt, auf den Bildern fehlen die Verschwundenen. Ausencias (Abwesenheiten) hat Gustavo Germano sein Projekt genannt." ;
    schema1:alternateName "das Fotoprojekt ausencias von Gustavo Germano mit Texten zur Diktatur in Argentinien 1976-1983" ;
    schema1:author <http://example.org/kg/person/arias_lola>,
        <http://example.org/kg/person/benedetti_mario>,
        <http://example.org/kg/person/borges_jorge_luis>,
        <http://example.org/kg/person/cortazar_julio>,
        <http://example.org/kg/person/gelman_juan>,
        <http://example.org/kg/person/germano_gustavo>,
        <http://example.org/kg/person/verbitsky_horacio>,
        <http://example.org/kg/person/walsh_rodolfo_j> ;
    schema1:datePublished "2010" ;
    schema1:genre "Aufsatzsammlung",
        "Ausstellungskatalog",
        "Erlebnisbericht" ;
    schema1:inLanguage "ger" ;
    schema1:isbn "3940233439",
        "9783940233431" ;
    schema1:name "Verschwunden" ;
    schema1:publisher <http://example.org/kg/organization/munchner_fruhling_verlag> ;
    schema1:translator <http://example.org/kg/person/solms_maya>,
        <http://example.org/kg/person/uhly_steven> .

