<http://example.org/kg/work/897031938> a schema1:Book ;
    rdfs:label "Conversación en Princeton con Rubén Gallo" ;
    schema1:about <http://example.org/kg/subject/journalism_and_literature>,
        <http://example.org/kg/subject/literature>,
        <http://example.org/kg/subject/politics_and_literature> ;
    schema1:abstract "En estas conversaciones, el Nobel, con su brillantez acostumbrada, habla del oficio de escritor y de los retos a los que se enfrenta en la construcción de sus novelas, pero también ofrece un análisis inteligente de la actualidad. Es especialmente conmovedora la charla con Philippe Lançon, periodista del Charlie Hebdo que sobrevivió al atentado islamista perpetrado ese mismo año." ;
    schema1:author <http://example.org/kg/person/vargas_llosa_mario> ;
    schema1:bookEdition "Primera edición" ;
    schema1:contributor <http://example.org/kg/person/gallo_ruben> ;
    schema1:datePublished "septiembre de 2017" ;
    schema1:genre "Interview" ;
    schema1:inLanguage "spa" ;
    schema1:isbn "9788420431789" ;
    schema1:name "Conversación en Princeton con Rubén Gallo" ;
    schema1:publisher <http://example.org/kg/organization/alfaguara> .

