<http://example.org/kg/work/731322215> a schema1:Book ;
    rdfs:label "Perú" ;
    schema1:about <http://example.org/kg/subject/peru>,
        <http://example.org/kg/subject/sculpture_peruvian> ;
    schema1:abstract "La escultura y la naturaleza -- La escultura en el periodo Precerámico -- El periodo inicial: la aparición de la cerámica y el tallado en piedra -- La escultura de barro en la arquitectura -- El arte Chavín: piedra y transcendencia -- Orígenes y técnicas de la cerámica escultórica en el antiguo Perú -- Arte ritual y arte profano: confrontación -- Representaciones cerámicas vinculadas al chamanismo -- El ser humano y la naturaleza a través de la cerámica escultórica -- El soporte de madera en el mundo prehispánico -- Machu Picchu y la arquitectura escultórica monumental -- Santuarios de arquitectura escultórica monumental representativos del Horizonte Tardo -- Mates y Queros: receptáculos escultóricos -- Cerámica escultórica vidriada: fusión de culturas -- La influencia indígena y europea en la escultura religiosa de los siglos XVI-XVIII -- Formas escultóricas del arte religioso durante el Virreinato -- Los retablos virreinales a los retablos ayacuchanos del siglo XX -- La piedra de Huamanga: el espíritu de los tiempos -- La escultura monumental y funeraria en Lima a partir del siglo XIX -- Los inicios y el desarrollo de la escultura académica en el siglo XX -- La escultura figurativa y abstracta de la generación del 51 -- La generación del 68 y destacados contemporáneos de la generación de los 80 -- La generación de los 80: entre la violencia y la crueldad -- Ancestralismos y la escultura lúdica -- Muestra de escultura actual -- Ampliación de leyendas" ;
    schema1:alternateName "escultura de ayer y hoy ; desde sus inicios hasta nuestros días" ;
    schema1:bookEdition "1. ed." ;
    schema1:contributor <http://example.org/kg/person/mujica_marisa>,
        <http://example.org/kg/person/tord_maria_helena>,
        <http://example.org/kg/person/vargas_llosa_mario> ;
    schema1:datePublished "2011" ;
    schema1:inLanguage "spa" ;
    schema1:isbn "6124088371",
        "9786124088377" ;
    schema1:name "Perú" ;
    schema1:publisher <http://example.org/kg/organization/universidad_de_san_martin_de_porres_facultad_de_ciencias_de_la_comunicacion_turismo_y_psicologia> .

