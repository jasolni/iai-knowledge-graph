<http://example.org/kg/work/887791689> a schema1:Book ;
    rdfs:label "Imperio de la fortuna" ;
    schema1:abstract "Basada en la clásica historia del autor latinoamericano Juan Rulfo, este melodrama narra la vida de Dionisio Pinzón, un campesino muy pobre que vive en un pequeño pueblo mexicano con su madre. Cuando le regalan un gallo moribundo, Dionisio se interesa en jugar. Con su gallo ya recuperado, busca su fortuna en las ferias campesinas. Esta obra de Arturo Ripstein es en parte un homenaje al trabajo de Buñuel en México" ;
    schema1:contributor <http://example.org/kg/person/garcia_diego>,
        <http://example.org/kg/person/lopez_lechuga_hector>,
        <http://example.org/kg/person/paz_alicia>,
        <http://example.org/kg/person/ripstein_arturo>,
        <http://example.org/kg/person/rulfo_juan> ;
    schema1:datePublished "[2008?]" ;
    schema1:genre "DVD-Video",
