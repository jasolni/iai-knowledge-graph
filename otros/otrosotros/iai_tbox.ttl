@prefix bf: <http://id.loc.gov/ontologies/bibframe/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix iai: <http://www.iai.spk-berlin.de/tbox#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bf:classification a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bf:Instance schema:ArchiveComponent ) ] ;
    rdfs:range xsd:string .

bf:hasInstance a owl:ObjectProperty ;
    rdfs:domain bf:Work ;
    rdfs:range bf:Instance ;
    owl:inverseOf bf:instanceOf .

bf:hasItem a owl:ObjectProperty ;
    rdfs:domain bf:Instance ;
    rdfs:range bf:Item ;
    owl:inverseOf bf:itemOf .

bf:shelfMark a owl:DatatypeProperty ;
    rdfs:domain bf:Item ;
    rdfs:range xsd:string .

schema:Country a owl:Class ;
    rdfs:subClassOf schema:AdministrativeArea .

schema:EducationEvent a owl:Class ;
    rdfs:subClassOf schema:Event .

schema:EducationalOrganization a owl:Class ;
    rdfs:subClassOf schema:Organization .

schema:ExhibitionEvent a owl:Class ;
    rdfs:subClassOf schema:Event .

schema:GovernmentOrganization a owl:Class ;
    rdfs:subClassOf schema:Organization .

schema:Library a owl:Class ;
    rdfs:subClassOf schema:Organization .

schema:LiteraryEvent a owl:Class ;
    rdfs:subClassOf schema:Event .

schema:Project a owl:Class ;
    rdfs:subClassOf schema:Organization .

schema:Review a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:ScholarlyArticle a owl:Class ;
    rdfs:subClassOf schema:Article .

schema:ScreeningEvent a owl:Class ;
    rdfs:subClassOf schema:Event .

schema:ShortStory a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:SocialEvent a owl:Class ;
    rdfs:subClassOf schema:Event .

schema:VideoObject a owl:Class ;
    rdfs:subClassOf schema:MediaObject .

schema:VisualArtwork a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:about a owl:ObjectProperty ;
    rdfs:domain schema:Thing ;
    rdfs:range schema:Thing .

schema:actor a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Movie iai:TheatricalAdaptation schema:TVSeries ) ] ;
    rdfs:range schema:Person ;
    owl:inverseOf iai:actedIn .

schema:attendee a owl:ObjectProperty ;
    rdfs:domain schema:Event ;
    rdfs:range schema:Person .

schema:birthDate a owl:DatatypeProperty ;
    rdfs:domain schema:Person ;
    rdfs:range xsd:date .

schema:birthPlace a owl:ObjectProperty ;
    rdfs:domain schema:Person ;
    rdfs:range schema:Place .

schema:datePublished a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:CreativeWork bf:Instance ) ] ;
    rdfs:range xsd:gYear .

schema:deathDate a owl:DatatypeProperty ;
    rdfs:domain schema:Person ;
    rdfs:range xsd:date .

schema:description a owl:DatatypeProperty ;
    rdfs:domain schema:Thing ;
    rdfs:range rdfs:Literal .

schema:editor a owl:ObjectProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range schema:Person ;
    owl:inverseOf iai:hasEdited .

schema:endDate a owl:DatatypeProperty ;
    rdfs:domain schema:Event ;
    rdfs:range xsd:dateTime .

schema:genre a owl:DatatypeProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range rdfs:Literal .

schema:identifier a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bf:Item schema:Movie schema:MusicRecording schema:Person ) ] ;
    rdfs:range xsd:string .

schema:illustrator a owl:ObjectProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range schema:Person ;
    owl:inverseOf iai:hasIllustrated .

schema:inLanguage a owl:DatatypeProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range xsd:string .

schema:isPartOf a owl:ObjectProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range schema:CreativeWork .

schema:isbn a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Book bf:Instance ) ] ;
    rdfs:range xsd:string .

schema:issn a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Periodical bf:Instance ) ] ;
    rdfs:range xsd:string .

schema:location a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Event schema:Organization ) ] ;
    rdfs:range schema:Place .

schema:lyrics a owl:DatatypeProperty ;
    rdfs:domain schema:MusicComposition ;
    rdfs:range rdfs:Literal .

schema:maximumAttendeeCapacity a owl:DatatypeProperty ;
    rdfs:domain schema:Event ;
    rdfs:range xsd:integer .

schema:name a owl:DatatypeProperty ;
    rdfs:domain schema:Thing ;
    rdfs:range rdfs:Literal .

schema:numberOfPages a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Book bf:Instance schema:Thesis schema:Article ) ] ;
    rdfs:range xsd:integer .

schema:organizer a owl:ObjectProperty ;
    rdfs:domain schema:Event ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:Person schema:Organization ) ] .

schema:performer a owl:ObjectProperty ;
    rdfs:domain schema:Event ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:Person schema:PerformingGroup ) ] .

schema:publisher a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:CreativeWork bf:Instance ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:Organization schema:Person ) ] ;
    owl:inverseOf iai:hasPublished .

schema:recordingOf a owl:ObjectProperty ;
    rdfs:domain schema:MusicRecording ;
    rdfs:range schema:MusicComposition .

schema:startDate a owl:DatatypeProperty ;
    rdfs:domain schema:Event ;
    rdfs:range xsd:dateTime .

schema:translator a owl:ObjectProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range schema:Person ;
    owl:inverseOf iai:hasTranslated .

schema:url a owl:DatatypeProperty ;
    rdfs:domain schema:Thing ;
    rdfs:range xsd:anyURI .

schema:workPresented a owl:ObjectProperty ;
    rdfs:domain schema:Event ;
    rdfs:range schema:CreativeWork .

swrla:isRuleEnabled a owl:AnnotationProperty .

iai: a owl:Ontology .

iai:Poem a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

iai:attendeeCount a owl:DatatypeProperty ;
    rdfs:domain schema:Event ;
    rdfs:range xsd:integer .

iai:awardYear a owl:DatatypeProperty ;
    rdfs:domain iai:Award ;
    rdfs:range xsd:gYear .

iai:createdBy a owl:ObjectProperty ;
    rdfs:domain iai:FictionalCharacter ;
    rdfs:range schema:Person ;
    owl:inverseOf iai:hasCreatedCharacter ;
    owl:propertyChainAxiom ( [ owl:inverseOf schema:character ] schema:author ) .

iai:hasInfluenced a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:CreativeWork schema:Person bf:Work iai:LiteraryMovement ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:CreativeWork schema:Person bf:Work iai:LiteraryMovement ) ] ;
    owl:inverseOf iai:influencedBy .

iai:readerCount a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bf:Instance bf:Item schema:Book ) ] ;
    rdfs:range xsd:integer .

iai:receivedAward a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Person schema:CreativeWork ) ] ;
    rdfs:range iai:Award .

bf:instanceOf a owl:ObjectProperty ;
    rdfs:domain bf:Instance ;
    rdfs:range bf:Work .

bf:itemOf a owl:ObjectProperty ;
    rdfs:domain bf:Item ;
    rdfs:range bf:Instance .

schema:AdministrativeArea a owl:Class ;
    rdfs:subClassOf schema:Place .

schema:ArchiveComponent a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:CreativeWorkSeries a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:MediaObject a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:Periodical a owl:Class ;
    rdfs:subClassOf schema:CreativeWorkSeries .

schema:Thesis a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:character a owl:ObjectProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range iai:FictionalCharacter .

iai:Author a owl:Class ;
    rdfs:subClassOf schema:Person ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( schema:Person [ a owl:Restriction ;
                        owl:onProperty [ owl:inverseOf schema:author ] ;
                        owl:someValuesFrom schema:CreativeWork ] ) ] .

iai:Director a owl:Class ;
    rdfs:subClassOf schema:Person ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( schema:Person [ a owl:Restriction ;
                        owl:onProperty [ owl:inverseOf schema:director ] ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( schema:Movie iai:TheatricalAdaptation ) ] ] ) ] .

iai:Musician a owl:Class ;
    rdfs:subClassOf schema:Person ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( schema:Person [ a owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf schema:byArtist ] ;
                                    owl:someValuesFrom schema:MusicRecording ] ) ] [ a owl:Restriction ;
                        owl:onProperty [ owl:inverseOf schema:composer ] ;
                        owl:someValuesFrom schema:MusicComposition ] ) ] .

iai:actedIn a owl:ObjectProperty ;
    rdfs:domain schema:Person ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:Movie iai:TheatricalAdaptation schema:TVSeries ) ] .

iai:authorOf a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Person schema:Organization ) ] ;
    rdfs:range schema:CreativeWork ;
    owl:inverseOf iai:hasAuthor .

iai:collaboratesWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Person schema:Organization ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:Person schema:Organization ) ] .

iai:directorOf a owl:ObjectProperty ;
    rdfs:domain schema:Person ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:Movie iai:TheatricalAdaptation schema:TVSeries ) ] ;
    owl:inverseOf iai:hasDirector .

iai:hasComposed a owl:ObjectProperty ;
    rdfs:domain schema:Person ;
    rdfs:range schema:MusicComposition .

iai:hasCreatedCharacter a owl:ObjectProperty ;
    rdfs:domain schema:Person ;
    rdfs:range iai:FictionalCharacter .

iai:hasEdited a owl:ObjectProperty ;
    rdfs:domain schema:Person ;
    rdfs:range schema:CreativeWork .

iai:hasIllustrated a owl:ObjectProperty ;
    rdfs:domain schema:Person ;
    rdfs:range schema:CreativeWork .

iai:hasInterpreted a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Person schema:MusicGroup ) ] ;
    rdfs:range schema:MusicRecording .

iai:hasPublished a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Organization schema:Person ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:CreativeWork bf:Instance ) ] .

iai:hasTranslated a owl:ObjectProperty ;
    rdfs:domain schema:Person ;
    rdfs:range schema:CreativeWork .

iai:mentorOf a owl:ObjectProperty ;
    rdfs:domain schema:Person ;
    rdfs:range schema:Person .

foaf:knows a owl:ObjectProperty ;
    rdfs:domain schema:Person ;
    rdfs:range schema:Person .

schema:Article a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

iai:m a swrl:Variable .

iai:mov a swrl:Variable .

xsd:date a rdfs:Datatype .

xsd:gYear a rdfs:Datatype .

schema:Book a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:MusicGroup a owl:Class ;
    rdfs:subClassOf schema:PerformingGroup .

schema:PerformingGroup a owl:Class ;
    rdfs:subClassOf schema:Organization .

schema:composer a owl:ObjectProperty ;
    rdfs:domain schema:MusicComposition ;
    rdfs:range schema:Person ;
    owl:inverseOf iai:hasComposed .

schema:memberOf a owl:ObjectProperty ;
    rdfs:domain schema:Person ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:Organization iai:LiteraryMovement ) ] .

iai:Award a owl:Class ;
    rdfs:subClassOf schema:Thing .

iai:hasAuthor a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bf:Instance schema:CreativeWork ) ],
        [ a owl:Class ;
            owl:unionOf ( schema:CreativeWork schema:Person ) ],
        schema:CreativeWork,
        schema:Thing ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:Organization schema:Person ) ] ;
    rdfs:subPropertyOf schema:author .

iai:hasDirector a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Movie schema:TVSeries iai:TheatricalAdaptation ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( bf:Item schema:Movie schema:MusicRecording schema:Person ) ],
        [ a owl:Class ;
            owl:unionOf ( schema:CreativeWork schema:Person ) ],
        [ a owl:Class ;
            owl:unionOf ( schema:MusicGroup schema:Person ) ],
        [ a owl:Class ;
            owl:unionOf ( schema:Organization schema:Person ) ],
        [ a owl:Class ;
            owl:unionOf ( schema:PerformingGroup schema:Person ) ],
        schema:Person,
        schema:Thing ;
    rdfs:subPropertyOf schema:director .

iai:influencedBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:CreativeWork schema:Person bf:Work iai:LiteraryMovement ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:CreativeWork schema:Person bf:Work iai:LiteraryMovement ) ] ;
    owl:propertyChainAxiom ( schema:isBasedOn schema:author ),
        ( [ owl:inverseOf schema:author ] schema:isBasedOn schema:author ),
        ( [ owl:inverseOf schema:byArtist ] schema:isBasedOn schema:author ),
        ( [ owl:inverseOf schema:director ] schema:isBasedOn schema:author ) .

iai:p1 a swrl:Variable .

iai:p2 a swrl:Variable .

iai:w a swrl:Variable .

schema:Place a owl:Class ;
    rdfs:subClassOf schema:Thing .

schema:isBasedOn a owl:ObjectProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range schema:CreativeWork ;
    rdfs:subPropertyOf iai:influencedBy .

schema:TVSeries a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:director a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Movie iai:TheatricalAdaptation schema:TVSeries ) ] ;
    rdfs:range schema:Person ;
    rdfs:subPropertyOf iai:hasDirector ;
    owl:equivalentProperty iai:hasDirector ;
    owl:inverseOf iai:directorOf .

iai:FictionalCharacter a owl:Class ;
    rdfs:subClassOf schema:Thing .

iai:b a swrl:Variable .

schema:byArtist a owl:ObjectProperty ;
    rdfs:domain schema:MusicRecording ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:Person schema:MusicGroup ) ] ;
    owl:inverseOf iai:hasInterpreted .

iai:LiteraryMovement a owl:Class ;
    rdfs:subClassOf schema:Thing .

iai:a a swrl:Variable .

bf:Work a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:MusicComposition a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

bf:Item a owl:Class ;
    rdfs:subClassOf schema:Thing .

iai:TheatricalAdaptation a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:Movie a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:MusicRecording a owl:Class ;
    rdfs:subClassOf schema:CreativeWork .

schema:author a owl:ObjectProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( schema:Person schema:Organization ) ] ;
    rdfs:subPropertyOf iai:hasAuthor ;
    owl:equivalentProperty iai:hasAuthor ;
    owl:inverseOf iai:authorOf .

bf:Instance a owl:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    owl:disjointWith bf:Item,
        bf:Work .

schema:Event a owl:Class ;
    rdfs:subClassOf schema:Thing .

schema:Thing a owl:Class .

schema:Organization a owl:Class ;
    rdfs:subClassOf schema:Thing ;
    owl:disjointWith schema:Person .

schema:CreativeWork a owl:Class ;
    rdfs:subClassOf schema:Thing .

schema:Person a owl:Class ;
    rdfs:subClassOf schema:Thing ;
    owl:disjointWith iai:FictionalCharacter .

[] a owl:Class ;
    rdfs:subClassOf schema:Person ;
    owl:intersectionOf ( schema:Person [ a owl:Restriction ;
                owl:onProperty [ owl:inverseOf schema:author ] ;
                owl:someValuesFrom schema:CreativeWork ] ) .

[] a owl:Class ;
    rdfs:subClassOf iai:Author ;
    owl:intersectionOf ( schema:Person [ a owl:Restriction ;
                owl:onProperty [ owl:inverseOf schema:author ] ;
                owl:someValuesFrom schema:CreativeWork ] ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf schema:byArtist ] ;
            owl:someValuesFrom schema:MusicRecording ] ;
    owl:intersectionOf ( schema:Person [ a owl:Restriction ;
                owl:onProperty [ owl:inverseOf schema:byArtist ] ;
                owl:someValuesFrom schema:MusicRecording ] ) .

[] a owl:Class ;
    rdfs:subClassOf schema:Person ;
    owl:intersectionOf ( schema:Person [ a owl:Restriction ;
                owl:onProperty [ owl:inverseOf schema:director ] ;
                owl:someValuesFrom [ a owl:Class ;
                        owl:unionOf ( schema:Movie iai:TheatricalAdaptation ) ] ] ) .

[] a owl:Class ;
    rdfs:subClassOf iai:Director ;
    owl:intersectionOf ( schema:Person [ a owl:Restriction ;
                owl:onProperty [ owl:inverseOf schema:director ] ;
                owl:someValuesFrom [ a owl:Class ;
                        owl:unionOf ( schema:Movie iai:TheatricalAdaptation ) ] ] ) .

[] a owl:Class ;
    rdfs:subClassOf schema:Person ;
    owl:unionOf ( [ a owl:Class ;
                owl:intersectionOf ( schema:Person [ a owl:Restriction ;
                            owl:onProperty [ owl:inverseOf schema:byArtist ] ;
                            owl:someValuesFrom schema:MusicRecording ] ) ] [ a owl:Restriction ;
                owl:onProperty [ owl:inverseOf schema:composer ] ;
                owl:someValuesFrom schema:MusicComposition ] ) .

[] a owl:Class ;
    rdfs:subClassOf iai:Musician ;
    owl:unionOf ( [ a owl:Class ;
                owl:intersectionOf ( schema:Person [ a owl:Restriction ;
                            owl:onProperty [ owl:inverseOf schema:byArtist ] ;
                            owl:someValuesFrom schema:MusicRecording ] ) ] [ a owl:Restriction ;
                owl:onProperty [ owl:inverseOf schema:composer ] ;
                owl:someValuesFrom schema:MusicComposition ] ) .

[] a owl:AllDisjointClasses ;
    owl:members ( bf:Item schema:CreativeWork schema:Event schema:Organization schema:Person schema:Place iai:Award iai:FictionalCharacter iai:LiteraryMovement ) .

[] a swrl:Imp ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 iai:w ;
                    swrl:classPredicate schema:CreativeWork ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DifferentIndividualsAtom ;
                            swrl:argument1 iai:p1 ;
                            swrl:argument2 iai:p2 ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 iai:w ;
                                    swrl:argument2 iai:p2 ;
                                    swrl:propertyPredicate schema:author ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 iai:w ;
                                            swrl:argument2 iai:p1 ;
                                            swrl:propertyPredicate schema:author ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 iai:p1 ;
                    swrl:argument2 iai:p2 ;
                    swrl:propertyPredicate iai:collaboratesWith ] ;
            rdf:rest () ] .

[] a swrl:Imp ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 iai:a ;
                    swrl:classPredicate schema:Person ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 iai:a ;
                            swrl:argument2 iai:mov ;
                            swrl:propertyPredicate schema:memberOf ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 iai:a ;
                                    swrl:argument2 iai:b ;
                                    swrl:propertyPredicate iai:mentorOf ] ;
                            rdf:rest () ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 iai:b ;
                    swrl:argument2 iai:mov ;
                    swrl:propertyPredicate iai:influencedBy ] ;
            rdf:rest () ] .

[] a swrl:Imp ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:DifferentIndividualsAtom ;
                    swrl:argument1 iai:a ;
                    swrl:argument2 iai:b ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 iai:a ;
                            swrl:argument2 iai:m ;
                            swrl:propertyPredicate schema:memberOf ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 iai:b ;
                                    swrl:argument2 iai:m ;
                                    swrl:propertyPredicate schema:memberOf ] ;
                            rdf:rest () ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 iai:a ;
                    swrl:argument2 iai:b ;
                    swrl:propertyPredicate foaf:knows ] ;
            rdf:rest () ] .

