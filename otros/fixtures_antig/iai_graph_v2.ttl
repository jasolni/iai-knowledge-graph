<http://example.org/kg/work/1936114119> a schema1:Book ;
    schema1:about <http://example.org/kg/person/castro_fidel>,
        <http://example.org/kg/person/castro_fidel_-_1926-2016>,
        <http://example.org/kg/subject/cuba>,
